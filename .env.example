# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_user_id_here

# Webhooks (optional): bearer token for POST https://pa.mattfae.com/hooks/<name>.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_TOKEN=

# Heartbeat (optional): ping URL from an external monitor such as healthchecks.io.
# The bot GETs it every 5 minutes; the monitor alerts if pings stop.
# HEARTBEAT_URL=

# iCloud calendar (optional): app-specific password from account.apple.com ->
# Sign-In and Security -> App-Specific Passwords. Revoke it there if leaked.
# ICLOUD_USERNAME=
# ICLOUD_APP_PASSWORD=
# ICLOUD_DEFAULT_CALENDAR=Home

# Database
DB_PATH=personal_assistant.db

# Timezone for prompt context (default: America/Chicago)
# TIMEZONE=America/Chicago
